              "listen": "prerequest",
              "script": {
                "exec": [
                  "// On dev server: docker exec lv360_backend_dev python -m app.db.seed",
                  "// Run that command, then send this request to confirm no duplicates"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — no duplicate users created', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('access_token present', () => pm.expect(j.access_token).to.be.a('string').and.not.empty);",
