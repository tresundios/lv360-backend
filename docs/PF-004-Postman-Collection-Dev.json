{
  "info": {
    "name": "PF-004 Seed Validation — Dev (dev.lamviec360.com)",
    "description": "PF-004 acceptance criteria validation against the dev environment.\n\nBase URL: https://dev.lamviec360.com\nIf the backend runs on port 8000 directly, change the baseUrl variable to https://dev.lamviec360.com:8000\n\nAll seed accounts use password: Test1234!\n\nWorkflow:\n1. Run folder '00 — Health' first to confirm the server is up\n2. Run 'AC1 — User Roles' top to bottom — tokens are auto-saved\n3. Run 'Token Lifecycle' to validate refresh/logout\n4. Run 'RBAC' to validate role enforcement\n5. Run 'AC5 — seed-reset Recovery' after running seed-reset on the server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dev.lamviec360.com",
      "description": "Change to https://dev.lamviec360.com:8000 if no reverse proxy is in front",
      "type": "string"
    },
    { "key": "accessToken",  "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId",       "value": "", "type": "string" },
    { "key": "caUserId",     "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 — Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Backend healthy', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql('healthy');",
                  "});",
                  "pm.test('Environment is development', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.environment).to.eql('development');",
                  "});",
                  "pm.test('Redis connected', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.redis).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Swagger UI accessible",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Swagger UI returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/docs"
          }
        }
      ]
    },
    {
      "name": "AC1 — User Roles",
      "item": [
        {
          "name": "T01 Login super_admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('No 2FA required', () => pm.expect(j.requires_2fa).to.be.false);",
                  "pm.test('access_token present', () => pm.expect(j.access_token).to.be.a('string').and.not.empty);",
                  "pm.test('Role is super_admin', () => pm.expect(j.user.role).to.eql('super_admin'));",
                  "pm.test('Status is active', () => pm.expect(j.user.status).to.eql('active'));",
                  "pm.test('first_login_complete true', () => pm.expect(j.user.first_login_complete).to.be.true);",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@seed.lamviec360.com\",\n  \"password\": \"Test1234!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
