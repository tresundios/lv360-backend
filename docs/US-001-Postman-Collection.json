    {
      "name": "06 — FK CASCADE DELETE",
      "description": "Verify FK CASCADE works: when a user is deleted, their refresh_tokens and social_accounts are also deleted. This is validated indirectly — after AI abuse terminates a session, all refresh tokens for that user are revoked.",
      "item": [
        {
          "name": "S17 — Login job_seeker for cascade test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"js.05@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S18 — AI abuse x4 (revokes ALL refresh_tokens for user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 4th strike triggers revocation of all refresh tokens",
                  "// This proves FK relationship between users → refresh_tokens works",
                  "const code = pm.response.code;",
                  "pm.test('Strike recorded or session terminated', () => {",
                  "  pm.expect([200, 401]).to.include(code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/ai-abuse",
            "header": [
              { "key": "Accept-Language", "value": "en" }
            ]
          }
        },
        {
          "name": "S19 — Refresh after cascade revoke (proves FK user_id → revoked)",
          "event": [
