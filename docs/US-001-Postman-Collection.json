{
  "info": {
    "name": "US-001 — F2.1 Database Schema Validation",
    "description": "Validates all acceptance criteria for US-001: Database Schema.\nTests that all 4 auth tables (users, refresh_tokens, team_invitations, social_accounts) exist with correct columns, indexes, FK relationships, and constraints.\n\nPre-requisites:\n- make up\n- make migrate\n- make seed\n\nBase URL: http://localhost:8000\nSeed password: Test1234!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "caUserId", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "description": "Set to a real company UUID from DB before running invite tests", "type": "string" },
    { "key": "newUserId", "value": "", "type": "string" },
    { "key": "inviteToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 — Health & Migration",
      "description": "AC1: Verify make migrate created tables and server is healthy.",
      "item": [
        {
          "name": "S01 — Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Backend healthy — migration ran', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "01 — AC2: users table",
      "description": "AC2: Validate users table has all required columns (id UUID PK, email UNIQUE, password_hash nullable, role enum, status enum, first_login_complete, consent_given, consent_timestamp, failed_login_count). Tests by exercising login + /me endpoints which read these columns.",
      "item": [
        {
          "name": "S02 — Login super_admin (validates email, password_hash, role, status)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('user.id is UUID', () => {",
                  "  pm.expect(j.user.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "});",
                  "",
                  "pm.test('user.email is string', () => {",
                  "  pm.expect(j.user.email).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('user.role is valid enum', () => {",
                  "  pm.expect(['super_admin','company_admin','hr_recruiter','viewer','job_seeker']).to.include(j.user.role);",
                  "});",
                  "",
                  "pm.test('user.status is valid enum', () => {",
                  "  pm.expect(['pending','active','suspended']).to.include(j.user.status);",
                  "});",
                  "",
                  "pm.test('user.first_login_complete is boolean', () => {",
                  "  pm.expect(j.user.first_login_complete).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('access_token issued', () => {",
                  "  pm.expect(j.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (j.access_token) {",
                  "  pm.collectionVariables.set('accessToken', j.access_token);",
                  "  pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "  pm.collectionVariables.set('userId', j.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S03 — GET /me (validates all user columns exposed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('Has id (UUID PK)', () => {",
                  "  pm.expect(j.id).to.match(/^[0-9a-f]{8}-/);",
                  "});",
                  "",
                  "pm.test('Has email (UNIQUE)', () => {",
                  "  pm.expect(j.email).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Has full_name', () => {",
                  "  pm.expect(j.full_name).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Has role (enum)', () => {",
                  "  pm.expect(['super_admin','company_admin','hr_recruiter','viewer','job_seeker']).to.include(j.role);",
                  "});",
                  "",
                  "pm.test('Has account_type (enum or null)', () => {",
                  "  if (j.account_type !== null) {",
                  "    pm.expect(['employer','job_seeker']).to.include(j.account_type);",
                  "  }",
                  "});",
                  "",
                  "pm.test('Has status (enum)', () => {",
                  "  pm.expect(['pending','active','suspended']).to.include(j.status);",
                  "});",
                  "",
                  "pm.test('Has first_login_complete (bool)', () => {",
                  "  pm.expect(j.first_login_complete).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('Has created_at (timestamp)', () => {",
                  "  pm.expect(j.created_at).to.be.a('string');",
                  "  pm.expect(new Date(j.created_at).getTime()).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "header": [
              { "key": "Accept-Language", "value": "en" }
            ]
          }
        },
        {
          "name": "S04 — Login job_seeker (validates consent_given column)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('user.role is job_seeker', () => {",
                  "  pm.expect(j.user.role).to.eql('job_seeker');",
                  "});",
                  "",
                  "pm.test('user.account_type is job_seeker', () => {",
                  "  pm.expect(j.user.account_type).to.eql('job_seeker');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"js.01@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S05 — Login with wrong password (validates password_hash check works)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 — password_hash comparison works', () => {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns INVALID_CREDENTIALS', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.detail.code).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@seed.lamviec360.com\", \"password\": \"WrongPassword!\"}"
            }
          }
        },
        {
          "name": "S06 — Duplicate email (validates UNIQUE constraint)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 — UNIQUE email constraint enforced', () => {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Returns EMAIL_TAKEN', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.detail.code).to.eql('EMAIL_TAKEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register/step2",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account_type\": \"job_seeker\", \"full_name\": \"Dup Test\", \"email\": \"superadmin@seed.lamviec360.com\", \"phone\": \"+84901234567\", \"password\": \"Test1234!\", \"consent_given\": true}"
            }
          }
        }
      ]
    },
    {
      "name": "02 — AC3: refresh_tokens table",
      "description": "AC3: Validate refresh_tokens table: id, user_id (FK CASCADE), token_hash, expires_at, revoked. Tests by exercising token refresh and logout which read/write these columns.",
      "item": [
        {
          "name": "S07 — Login to get refresh token (creates refresh_tokens row)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('refresh_token issued (proves refresh_tokens table exists)', () => {",
                  "  pm.expect(j.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S08 — Refresh token (validates token_hash lookup + expires_at check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — token refreshed', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('New access_token issued (old token_hash matched, not expired, not revoked)', () => {",
                  "  pm.expect(j.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('New refresh_token issued (rotation)', () => {",
                  "  pm.expect(j.refresh_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.refresh_token).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refreshToken}}\"}"
            }
          }
        },
        {
          "name": "S09 — Logout (validates revoked column set to true)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — logout success', () => pm.response.to.have.status(200));",
                  "pm.test('Returns LOGOUT_SUCCESS', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.code).to.eql('LOGOUT_SUCCESS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refreshToken}}\"}"
            }
          }
        },
        {
          "name": "S10 — Refresh after logout (validates revoked=true blocks refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 — revoked token rejected', () => pm.response.to.have.status(401));",
                  "pm.test('Returns SESSION_INVALIDATED', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.detail.code).to.eql('SESSION_INVALIDATED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refreshToken}}\"}"
            }
          }
        }
      ]
    },
    {
      "name": "03 — AC4: team_invitations table",
      "description": "AC4: Validate team_invitations table: id, company_id, email, role, token_hash, expires_at (now()+72h), accepted, revoked. Tests by creating and viewing an invitation.",
      "item": [
        {
          "name": "S11 — Login super_admin (for invite creation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S12 — Create invitation (validates team_invitations INSERT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 — invitation created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('invitation_id is UUID', () => {",
                  "  pm.expect(j.invitation_id).to.match(/^[0-9a-f]{8}-/);",
                  "});",
                  "",
                  "pm.test('Returns INVITE_SENT', () => {",
                  "  pm.expect(j.code).to.eql('INVITE_SENT');",
                  "});",
                  "",
                  "pm.collectionVariables.set('invitationId', j.invitation_id);",
                  "",
                  "pm.test('invite_token returned', () => {",
                  "  pm.expect(j.invite_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('inviteToken', j.invite_token);",
                  "console.log('inviteToken auto-saved: ' + j.invite_token.substring(0, 20) + '...');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/invite",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"us001-invite-test@test.com\", \"role\": \"hr_recruiter\", \"company_id\": \"{{companyId}}\"}"
            }
          }
        },
        {
          "name": "S13 — View invitation (validates SELECT on team_invitations with expires_at, accepted, revoked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — invitation found', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('Has id (UUID PK)', () => {",
                  "  pm.expect(j.id).to.match(/^[0-9a-f]{8}-/);",
                  "});",
                  "",
                  "pm.test('Has email', () => {",
                  "  pm.expect(j.email).to.eql('us001-invite-test@test.com');",
                  "});",
                  "",
                  "pm.test('Has role (enum)', () => {",
                  "  pm.expect(j.role).to.eql('hr_recruiter');",
                  "});",
                  "",
                  "pm.test('Has company_id (UUID)', () => {",
                  "  pm.expect(j.company_id).to.match(/^[0-9a-f]{8}-/);",
                  "});",
                  "",
                  "pm.test('Has expires_at (timestamp)', () => {",
                  "  pm.expect(j.expires_at).to.be.a('string');",
                  "  const exp = new Date(j.expires_at);",
                  "  const now = new Date();",
                  "  const hoursUntilExpiry = (exp - now) / 3600000;",
                  "  pm.expect(hoursUntilExpiry).to.be.above(70); // ~72h from creation",
                  "  pm.expect(hoursUntilExpiry).to.be.below(73);",
                  "});",
                  "",
                  "pm.test('accepted is false', () => {",
                  "  pm.expect(j.accepted).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/invite/{{inviteToken}}",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Accept-Language", "value": "en" }
            ]
          }
        }
      ]
    },
