{
  "info": {
    "name": "US-002 — F2.2 Security Utilities Validation",
    "description": "Validates all acceptance criteria for US-002: Security Utilities.\nTests JWT creation/verification, password hashing, token expiry, and env var configuration through API endpoints.\n\nPre-requisites:\n- make up\n- make seed\n\nBase URL: http://localhost:8000\nSeed password: Test1234!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 — Health",
      "item": [
        {
          "name": "S01 — Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Backend healthy', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "01 — AC1: create_access_token (JWT claims + expiry)",
      "description": "AC1: Login returns a signed JWT with sub, role, type, iat, exp claims and correct expiry.",
      "item": [
        {
          "name": "S02 — Login → JWT issued with correct claims",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "",
                  "pm.test('access_token is a JWT string', () => {",
                  "  pm.expect(j.access_token).to.be.a('string');",
                  "  const parts = j.access_token.split('.');",
                  "  pm.expect(parts.length).to.eql(3); // header.payload.signature",
                  "});",
                  "",
                  "// Decode payload (base64url)",
                  "const payload = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "",
                  "pm.test('JWT has sub claim (user_id UUID)', () => {",
                  "  pm.expect(payload.sub).to.match(/^[0-9a-f]{8}-/);",
                  "});",
                  "",
                  "pm.test('JWT has role claim', () => {",
                  "  pm.expect(['super_admin','company_admin','hr_recruiter','viewer','job_seeker']).to.include(payload.role);",
                  "});",
                  "",
                  "pm.test('JWT has type=access', () => {",
                  "  pm.expect(payload.type).to.eql('access');",
                  "});",
                  "",
                  "pm.test('JWT has iat claim', () => {",
                  "  pm.expect(payload.iat).to.be.a('number');",
                  "  pm.expect(payload.iat).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('JWT has exp claim', () => {",
                  "  pm.expect(payload.exp).to.be.a('number');",
                  "  pm.expect(payload.exp).to.be.above(payload.iat);",
                  "});",
                  "",
                  "pm.test('exp - iat = ~60 minutes (JWT_EXPIRY_MINUTES default)', () => {",
                  "  const deltaMinutes = (payload.exp - payload.iat) / 60;",
                  "  pm.expect(deltaMinutes).to.be.within(59, 61);",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S03 — Login different role → role claim matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const payload = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "",
                  "pm.test('JWT role = job_seeker for job_seeker login', () => {",
                  "  pm.expect(payload.role).to.eql('job_seeker');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"js.01@seed.lamviec360.com\", \"password\": \"Test1234!\"}"
            }
          }
        },
        {
          "name": "S04 — Valid JWT grants access to /me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — JWT verified successfully', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.test('Returns user profile (JWT sub matched user)', () => {",
                  "  pm.expect(j.id).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "header": [
              { "key": "Accept-Language", "value": "en" }
            ]
          }
        }
      ]
    },
    {
