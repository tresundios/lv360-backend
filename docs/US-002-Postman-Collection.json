                  "// This JWT was signed with 'wrong-secret' instead of the real JWT_SECRET.",
                  "// It has valid structure but wrong signature.",
                  "// Generated via: jwt.encode({'sub':'fake','role':'super_admin','type':'access','iat':1716500000,'exp':9999999999}, 'wrong-secret', 'HS256')"
