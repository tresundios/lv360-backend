    {
      "name": "05 — Reset token validation",
      "description": "Validates create_reset_token / decode_reset_token through the password reset flow.",
      "item": [
        {
          "name": "S19 — Forgot password → 200 (reset token created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
