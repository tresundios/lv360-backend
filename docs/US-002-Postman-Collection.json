                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/forgot-password",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@seed.lamviec360.com\"}"
            }
          }
        },
        {
          "name": "S20 — Invalid reset token → 400 RESET_LINK_INVALID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 — invalid reset token rejected', () => {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Returns RESET_LINK_INVALID', () => {",
                  "  pm.expect(pm.response.json().detail.code).to.eql('RESET_LINK_INVALID');",
                  "});"
