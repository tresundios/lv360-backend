{
  "info": {
    "name": "PF-004 Seed Data Validation",
    "description": "Tests all 5 acceptance criteria for PF-004 seed script.\nBase URL: http://localhost:8000\nAll seed accounts use password: Test1234!\n\nWorkflow:\n1. Run 'Health Check' first\n2. Login with each role (T01–T05)\n3. Use 'Set Token' steps to store access_token in collection variable\n4. Run protected endpoint tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "caUserId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 — Health & Infra",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Backend healthy', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "AC1 — User Roles",
      "item": [
        {
          "name": "T01 Login super_admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('No 2FA required', () => pm.expect(j.requires_2fa).to.be.false);",
                  "pm.test('access_token present', () => pm.expect(j.access_token).to.not.be.empty);",
                  "pm.test('Role is super_admin', () => pm.expect(j.user.role).to.eql('super_admin'));",
                  "pm.test('Status is active', () => pm.expect(j.user.status).to.eql('active'));",
                  "pm.test('first_login_complete', () => pm.expect(j.user.first_login_complete).to.be.true);",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@seed.lamviec360.com\",\n  \"password\": \"Test1234!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
