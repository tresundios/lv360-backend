COMPOSE_PROJECT_NAME=lv360_backend_dev
DATABASE_URL=postgresql://postgres:password@postgres:5432/lv360
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=password
CORS_ORIGINS=http://localhost:3080,https://appdev.lamviec360.com

# --- Auth / JWT ---
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=30

# --- OTP ---
OTP_TTL_MINUTES=10

# --- Team Invite ---
INVITE_TTL_HOURS=72

# --- SendGrid ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@lamviec360.com

# --- Frontend URL (for reset/invite links) ---
FRONTEND_URL=http://localhost:3080

# --- OAuth (placeholder — set to activate with zero code changes) ---
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_ZALO_APP_ID=
AUTH_ZALO_APP_SECRET=
